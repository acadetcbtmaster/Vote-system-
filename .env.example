# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-side Supabase (exposed to browser for Realtime and Auth)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Admin Authentication Secret (used for securing administrative endpoints)
ADMIN_SECRET_KEY="super-secret-admin-token-change-in-production"

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"

# Optional Gemini API key
GEMINI_API_KEY=""
